generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Vai trò của người dùng trên dApp
enum UserRole {
  CLIENT
  FREELANCER
  BOTH
}

/// Trạng thái của thỏa thuận Micro-Escrow
enum DealStatus {
  LOCKED
  SUBMITTED
  RELEASED
}

/// Bảng lưu trữ thông tin Người dùng (khi kết nối ví Stellar)
model User {
  id              String     @id @default(uuid())
  address         String     @unique
  name            String?
  email           String?
  avatarUrl       String?
  role            UserRole   @default(BOTH)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  clientDeals     Deal[]     @relation("ClientDeals")
  freelancerDeals Deal[]     @relation("FreelancerDeals")

  @@index([address])
}

/// Bảng lưu trữ thông tin Escrow Deals phục vụ Caching & Query từ Frontend dApp
model Deal {
  id                String     @id @default(uuid())
  dealIdOnChain     BigInt     @unique
  clientAddress     String
  client            User?      @relation("ClientDeals", fields: [clientAddress], references: [address])
  freelancerAddress String
  freelancer        User?      @relation("FreelancerDeals", fields: [freelancerAddress], references: [address])
  tokenAddress      String
  amount            String
  proofUrl          String?
  status            DealStatus @default(LOCKED)
  txHash            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([clientAddress])
  @@index([freelancerAddress])
  @@index([dealIdOnChain])
}
